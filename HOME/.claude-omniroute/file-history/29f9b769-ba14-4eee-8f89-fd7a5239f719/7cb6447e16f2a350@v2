import bcrypt from "bcryptjs";
import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

async function createAdmin() {
  const email = process.env.ADMIN_EMAIL || "admin@kidsmaroc.ma";
  const password = process.env.ADMIN_PASSWORD || "AdminKids2026!";
  const fullName = "Administrateur Kids Maroc";

  console.log(`Checking/Creating admin user (${email})...`);

  const existing = await prisma.user.findUnique({ where: { email } });
  const passwordHash = await bcrypt.hash(password, 10);

  if (existing) {
    await prisma.user.update({
      where: { email },
      data: { role: "ADMIN", passwordHash },
    });
    console.log("✅ Existing user updated to ADMIN role with secure password.");
  } else {
    await prisma.user.create({
      data: {
        email,
        passwordHash,
        fullName,
        role: "ADMIN",
      },
    });
    console.log("✅ New ADMIN user created successfully.");
  }
}

createAdmin()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });